# =============================================================================
# FENICE FLEET CONTROL - Variables de entorno
# =============================================================================
# Copia este archivo como `.env.local` y ajusta lo que necesites.
# NUNCA subas `.env.local` al repositorio: contiene credenciales reales.
#
# La plataforma arranca sin configurar NADA de esto: los valores por defecto
# activan el modo demostracion completo (simulador GPS + dataset interno).
# =============================================================================


# -----------------------------------------------------------------------------
# 1. AUTENTICACION
# -----------------------------------------------------------------------------
# Login propio por RUT y contrasena, validado contra la tabla `usuarios` en
# Supabase (NO usa Supabase Auth). Ver docs/SUPABASE-INTEGRATION.md.
#
# `false` (valor por defecto): plataforma abierta, sin login. Util para
# desarrollo y demostracion sin configurar nada.
# `true`: exige sesion valida en toda la aplicacion salvo /login,
# /seguimiento y /conductor. Requiere SUPABASE_URL y
# SUPABASE_SERVICE_ROLE_KEY (seccion 1b).
AUTH_ENABLED=false


# -----------------------------------------------------------------------------
# 1b. SUPABASE (base interna de la plataforma)
# -----------------------------------------------------------------------------
# Aloja login, flota, rutas, geocercas, alertas, configuracion y evidencia de
# entrega. NUNCA clientes ni despachos: esos siguen en la base externa de
# Fenice (seccion 4). Ver docs/SUPABASE-INTEGRATION.md para la puesta en
# marcha completa (crear proyecto, correr supabase/schema.sql, crear el
# primer administrador).
#
# Sin configurar, cada almacen sigue funcionando en memoria del proceso,
# sembrado desde el dataset de demostracion, exactamente como hoy.
SUPABASE_URL=
# La "service_role" key, NUNCA la "anon": se usa solo desde el servidor y se
# salta Row Level Security por diseno de Supabase. Tan sensible como una
# contrasena de base de datos.
SUPABASE_SERVICE_ROLE_KEY=

# Vigencia de la sesion de login, en horas.
SESSION_TTL_HOURS=12
# Intentos fallidos antes de bloquear temporalmente la cuenta.
LOGIN_MAX_ATTEMPTS=5
# Duracion del bloqueo, en minutos.
LOGIN_LOCKOUT_MINUTES=15


# -----------------------------------------------------------------------------
# 2. SELECCION DE PROVEEDORES
# -----------------------------------------------------------------------------
# Telemetria GPS:      mock | traccar
# mock = simulador (solo con DEMO_MODE=true) | traccar | 3dtracking
GPS_PROVIDER=3dtracking

# Fuente operacional:  mock | external   (clientes, pedidos, OT, rutas)
OPERATIONS_PROVIDER=mock

# Geocodificacion:     none | nominatim | maptiler | mapbox | google
# Se mantiene en `none` a proposito: la geocodificacion masiva automatica
# puede generar costos o bloqueos por limite de tasa.
GEOCODING_PROVIDER=none

# Calculo de ETA:      estimated | osrm | mapbox | google | maptiler
ROUTING_PROVIDER=estimated


# -----------------------------------------------------------------------------
# 3. SERVIDOR GPS TRACCAR
# -----------------------------------------------------------------------------
# Cadena de integracion prevista:
#   Teltonika FMC130 -> SIM 4G -> servidor Traccar -> Fenice Fleet Control
#
# Estas credenciales SOLO se usan en el servidor. El navegador nunca las ve:
# consume /api/gps/*, que actua como proxy.
# Requiere TRACCAR_TOKEN, o bien TRACCAR_USERNAME + TRACCAR_PASSWORD.
# Ver docs/GPS-INTEGRATION.md
TRACCAR_BASE_URL=
TRACCAR_USERNAME=
TRACCAR_PASSWORD=
TRACCAR_TOKEN=
# El WebSocket requiere TRACCAR_TOKEN (la API estandar no admite cabeceras).
# Sin el, la suscripcion degrada automaticamente a consulta periodica.
TRACCAR_WEBSOCKET_URL=

# -----------------------------------------------------------------------------
# 3b. SERVIDOR GPS 3DTRACKING
# -----------------------------------------------------------------------------
# Requerido cuando GPS_PROVIDER=3dtracking. Sin estas dos credenciales, el
# proveedor no se puede instanciar y la aplicacion degrada a "SIN CONEXION"
# (cero vehiculos, cero posiciones) en lugar de fallar o mostrar datos falsos.
# Ver docs/3DTRACKING-INTEGRATION.md
TRIDTRACKING_BASE_URL=https://apiv2.3dtracking.net
TRIDTRACKING_USERNAME=
TRIDTRACKING_PASSWORD=
TRIDTRACKING_TIMEOUT_MS=15000


# -----------------------------------------------------------------------------
# 4. BASE DE DATOS EXTERNA DE FENICE (SOLO LECTURA)
# -----------------------------------------------------------------------------
# IMPORTANTE: el usuario debe tener permisos EXCLUSIVAMENTE de lectura.
# La plataforma bloquea INSERT/UPDATE/DELETE/ALTER/DROP antes de tocar la red,
# pero eso NO sustituye a un usuario correctamente restringido.
# Ver docs/EXTERNAL-DATABASE-INTEGRATION.md
EXTERNAL_DB_ENGINE=
EXTERNAL_DB_HOST=
EXTERNAL_DB_PORT=
EXTERNAL_DB_NAME=
EXTERNAL_DB_USER=
EXTERNAL_DB_PASSWORD=
EXTERNAL_DB_SCHEMA=
EXTERNAL_DB_SSL=true


# -----------------------------------------------------------------------------
# 5. BASE DE DATOS INTERNA DE LA PLATAFORMA
# -----------------------------------------------------------------------------
# PostgreSQL propio de Fenice Fleet Control. Guardara lo que la plataforma
# genera y la base de Fenice no contiene: geocercas, eventos de geocerca,
# visitas detectadas, estado de alertas y configuracion operacional.
# Mientras este vacio, esos datos viven en memoria del proceso.
DATABASE_URL=


# -----------------------------------------------------------------------------
# 6. CARTOGRAFIA Y RUTEO
# -----------------------------------------------------------------------------
# El proveedor de mapa es publico por naturaleza (el navegador debe descargar
# los tiles), por eso usa el prefijo NEXT_PUBLIC_. Restringe la clave por
# dominio en el panel del proveedor.
#
# Proveedor de mapa: osm | maptiler | mapbox | carto-light
# `carto-dark` y `osm` funcionan sin clave y sirven para desarrollo y demo.
# Para produccion comercial, contrata MapTiler o Mapbox.
NEXT_PUBLIC_MAP_PROVIDER=osm
NEXT_PUBLIC_MAPTILER_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=

# Claves de servidor (geocodificacion y ruteo). No se exponen al navegador.
MAPTILER_API_KEY=
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=
# Instancia OSRM propia o publica para calcular ETA real.
OSRM_BASE_URL=


# -----------------------------------------------------------------------------
# 7. REGLAS OPERACIONALES (valores iniciales)
# -----------------------------------------------------------------------------
# Estos valores siembran la configuracion al arrancar. Se pueden ajustar en
# caliente desde /configuracion sin reiniciar el servidor.

# --- Estado comercial del cliente ---
# Verde: 0 a CLIENT_ACTIVE_MAX_DAYS
# Amarillo: hasta CLIENT_WARNING_MAX_DAYS
# Rojo: por encima de CLIENT_WARNING_MAX_DAYS
CLIENT_ACTIVE_MAX_DAYS=21
CLIENT_WARNING_MAX_DAYS=60

# --- Salud de la telemetria (segundos sin posicion) ---
GPS_STALE_SECONDS=60
GPS_SIGNAL_LOST_SECONDS=180
GPS_OFFLINE_SECONDS=600
# Cadencia del stream y del respaldo por consulta periodica.
GPS_REFRESH_INTERVAL_MS=15000

# Transporte de las posiciones en vivo hacia el navegador:
#   auto     SSE con degradacion automatica. Correcto en un servidor propio.
#   sse      fuerza streaming.
#   polling  consultas periodicas. OBLIGATORIO en plataformas sin servidor
#            (Vercel, Netlify), donde un stream se corta cada pocos segundos.
GPS_LIVE_TRANSPORT=auto

# Vida maxima de un stream SSE, en segundos. Debe quedar por debajo del limite
# de la plataforma para cerrar limpiamente en vez de que lo corten.
GPS_STREAM_MAX_SECONDS=1800

# --- Control de ruta ---
# Metros de tolerancia respecto al corredor planificado.
ROUTE_DEVIATION_DISTANCE=300
# Segundos continuos fuera del corredor antes de alertar.
ROUTE_DEVIATION_TIME=120
# Segundos fuera de comuna autorizada antes de alertar.
OUT_OF_COMMUNE_TOLERANCE_SECONDS=300
# Segundos detenido fuera de geocerca para considerarlo detencion prolongada.
PROLONGED_STOP_SECONDS=900

# --- Geocercas de entrega ---
# Radio aplicado a cada direccion de despacho que no tenga uno propio.
DEFAULT_GEOFENCE_RADIUS_METERS=80
# Permanencia minima dentro de la geocerca para validar la visita.
# Con 0, basta con entrar al perimetro.
MIN_GEOFENCE_DWELL_TIME=60
# Si es `false`, la visita queda registrada como evidencia pero la entrega
# requiere confirmacion humana.
AUTO_CONFIRM_DELIVERY_ON_DWELL=true


# -----------------------------------------------------------------------------
# 8. PLAN DE PRODUCTO
# -----------------------------------------------------------------------------
# Plan contratado: base | medium | advanced
# Determina que funcionalidades se pueden usar. Cambiar este valor es la unica
# operacion necesaria para entregar una version distinta al cliente.
NEXT_PUBLIC_PRODUCT_PLAN=base

# Mostrar junto a cada funcion a que plan pertenece.
NEXT_PUBLIC_SHOW_PLAN_BADGES=true

# Anunciar las funciones de planes superiores como oportunidad de mejora.
# Con `false`, TODO lo que el plan no cubre desaparece de la interfaz: es lo
# que permite entregar una version limpia sin revisar componente por componente.
NEXT_PUBLIC_SHOW_UPSELL=false


# -----------------------------------------------------------------------------
# 9. DATOS DE DEMOSTRACION
# -----------------------------------------------------------------------------
# Con `false`, la plataforma deja de servir informacion ficticia y muestra sus
# estados vacios a la espera de las fuentes reales.
# El comando `npm run demo:purge` fija estas variables automaticamente.
# PRODUCCION: apagado. Lo que se ve en pantalla viene de las fuentes reales.
# Ponerlo en `true` solo para formacion o una presentacion comercial.
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false


# -----------------------------------------------------------------------------
# 10. PROVEEDORES DE MAPA AVANZADOS (Plan Medio y Avanzado)
# -----------------------------------------------------------------------------
# Vista satelital e hibrida. Sin clave, la plataforma indica que la funcion
# requiere proveedor en lugar de mostrar un mapa vacio.
NEXT_PUBLIC_SATELLITE_PROVIDER=
NEXT_PUBLIC_TERRAIN_PROVIDER=

# Trafico en tiempo real: mapbox | tomtom | google
# NUNCA se genera trafico ficticio. Sin proveedor, la capa informa que
# requiere configuracion.
TRAFFIC_PROVIDER=
TRAFFIC_API_KEY=

# Asistente operacional (Plan Avanzado).
AI_PROVIDER=
AI_API_KEY=

# Notificaciones externas (Plan Avanzado).
NOTIFICATION_PROVIDER=

# ---------------------------------------------------------------------------
# Portal del conductor (Plan Medio)
# ---------------------------------------------------------------------------
# Clave con la que se firman los enlaces de ruta. El enlace ES la credencial
# del conductor: sin clave definida se genera una aleatoria al arrancar y los
# enlaces dejan de valer en cada reinicio (y entre instancias).
# Generar con: openssl rand -base64 48
DRIVER_PORTAL_SECRET=

# Vigencia del enlace en horas. Una jornada mas margen, no un enlace eterno.
DRIVER_TOKEN_TTL_HOURS=16

# Evidencia de entrega. Las fotografias se comprimen en el telefono antes de
# subirlas; este tope se aplica a la imagen ya comprimida.
PROOF_MAX_PHOTOS=4
PROOF_PHOTO_MAX_BYTES=900000

# Como se da por entregada una parada:
#   enter   entrar al radio de la geocerca basta
#   dwell   hay que permanecer el tiempo minimo
#   driver  la confirma el conductor desde su portal
#   hybrid  exige presencia GPS Y confirmacion del conductor
DELIVERY_DETECTION_MODE=hybrid
