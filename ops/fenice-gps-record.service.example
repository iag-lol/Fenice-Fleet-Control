# Adaptar User, WorkingDirectory y ExecStart a la instalacion real.
[Unit]
Description=Grabador GPS de Fenice Fleet Control
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fenice
WorkingDirectory=/srv/fenice-fleet-control
Environment=NODE_ENV=production
ExecStart=/usr/bin/node --conditions=react-server --import tsx scripts/record-gps.ts
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=multi-user.target
