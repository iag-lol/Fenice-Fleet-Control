# Piloto FMC130 / RBDC59 / 3DTracking
# Integra estos valores en .env.local; conserva las credenciales existentes.
# No uses la URL de la API como destino del hardware: 3DTracking entrega su host y puerto de recepcion.
GPS_PROVIDER=3dtracking
TRIDTRACKING_BASE_URL=https://apiv2.3dtracking.net
TRIDTRACKING_API_MODE=client
TRIDTRACKING_USERNAME=
TRIDTRACKING_PASSWORD=
TRIDTRACKING_TIMEOUT_MS=15000
GPS_LIVE_TRANSPORT=polling
GPS_REFRESH_INTERVAL_MS=15000
GPS_STALE_SECONDS=60
GPS_SIGNAL_LOST_SECONDS=180
GPS_OFFLINE_SECONDS=600
GPS_HISTORY_DIR=.fenice/gps-history
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false
# Para acceso por internet, configurar Supabase y habilitar login antes de exponer la flota.
AUTH_ENABLED=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPERATIONS_PROVIDER=mock
