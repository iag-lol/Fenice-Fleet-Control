{
  "name": "fenice-fleet-control",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.19 <25"
  },
  "description": "Fenice Fleet Control - Plataforma de control GPS y gestion logistica para Fenice SpA",
  "scripts": {
    "predev": "node scripts/build-map-viewport.mjs && node scripts/copy-maplibre-worker.mjs && node scripts/clean-stale-build.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/build-map-viewport.mjs && node scripts/copy-maplibre-worker.mjs && node scripts/clean-stale-build.mjs --force",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "build:rutas": "tsx scripts/build-route-geometry.ts",
    "demo:reset": "node scripts/demo-reset.mjs",
    "demo:purge": "node scripts/demo-purge.mjs",
    "import:comunas": "node scripts/import-communes.mjs && node scripts/build-map-viewport.mjs",
    "create:admin": "node scripts/create-admin-user.mjs",
    "gps:record": "node --conditions=react-server --import tsx scripts/record-gps.ts",
    "gps:check": "node --conditions=react-server --import tsx scripts/check-gps.ts",
    "gps:test": "vitest run src/services/gps src/lib/engines/gps-health.test.ts src/services/aggregation/merge-fleet.test.ts"
  },
  "dependencies": {
    "@next/env": "^15.5.27",
    "@supabase/supabase-js": "^2.115.0",
    "@tanstack/react-query": "^5.62.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.469.0",
    "maplibre-gl": "^6.9.0",
    "next": "^15.5.27",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "tsx": "^4.23.13",
    "web-push": "3.6.7",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/web-push": "3.6.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.27",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "0.35.5",
    "source-map-js": "^1.2.2",
    "brace-expansion@^1.1.7": "1.1.21",
    "brace-expansion@^5.0.5": "5.0.12",
    "postcss-selector-parser": "^7.1.6"
  }
}
